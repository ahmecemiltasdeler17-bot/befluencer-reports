# Client-safe Supabase (browser + server)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Platform origins (server-only) — never from Host / X-Forwarded-Host
# Local development (single origin is fine):
APP_URL=http://localhost:3000
PUBLIC_REPORT_URL=http://localhost:3000
MARKETING_SITE_URL=http://localhost:3001

# Production management project (example):
# APP_URL=https://app.befluencer.co
# PUBLIC_REPORT_URL=https://reports.befluencer.co
# MARKETING_SITE_URL=https://befluencer.co

# TikTok / Apify (server-only)
APIFY_API_TOKEN=
APIFY_TIKTOK_ACTOR_ID=
# APIFY_TIKTOK_CREATOR_ACTOR_ID=
# APIFY_TIKTOK_SOUND_ACTOR_ID=

# Scheduled sync (server-only)
CRON_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# Marketing-site form ingest (server-only).
# Same value as FORM_WEBHOOK_SECRET in befluencer-web. Minimum 24 characters,
# otherwise /api/public/leads treats it as unconfigured and returns 503.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
LEADS_INGEST_SECRET=

# Optional PDF browser path (local)
# CHROME_EXECUTABLE_PATH=
# Server-only 32-byte base64 key used for recoverable admin share links.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
SHARE_TOKEN_ENCRYPTION_KEY=
